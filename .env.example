# Server port
PORT=1279 # The fall of the Song Dynasty
GIN_MODE=release
# Optional path to the required YAML configuration file (default: config.yaml)
CONFIG_PATH=config.yaml

# Startup downloader and API server use the same database location.
DATA_DIR=data
DB_FILE=poetry.db

# Trust forwarded client IPs only from reverse proxies you operate.
# Leave empty for direct public serving (the secure default).
TRUSTED_PROXIES=

# HTTP connection timeouts (Go duration syntax)
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# GraphQL public-surface limits. Enable introspection only in trusted development.
GRAPHQL_INTROSPECTION=false
GRAPHQL_COMPLEXITY_LIMIT=1000
GRAPHQL_MAX_REQUEST_BODY_BYTES=1048576
